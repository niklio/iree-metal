PROJECT_NAME           = "iree-metal"
PROJECT_BRIEF          = "IREE Metal compiler, runtime, and PJRT integration reference"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ../..

INPUT                  = ../../compiler/plugins/target/MetalSPIRV \
                         ../../runtime/src/iree/hal/drivers/metal \
                         ../../integrations/pjrt/src/iree_pjrt
FILE_PATTERNS          = *.h *.cc *.cpp *.c *.m
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */test/* *_test.cc

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = IREE_API_EXPORT= \
                         IREE_API_PTR= \
                         IREE_ATTRIBUTE_UNUSED= \
                         IREE_HAL_METAL_API= \
                         __OBJC__=1

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
HAVE_DOT               = NO
