load("//build_tools/bazel:build_defs.oss.bzl", "iree_compiler_cc_test")
load("//build_tools/bazel:enforce_glob.bzl", "enforce_glob")
load("//build_tools/bazel:iree_lit_test.bzl", "iree_lit_test_suite")

package(
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_lit_test_suite(
    name = "lit",
    srcs = enforce_glob(
        # keep sorted
        ["smoketest.mlir"],
        include = ["*.mlir"],
    ),
    cfg = "//compiler:lit.cfg.py",
    tools = [
        "//tools:iree-opt",
        "@llvm-project//llvm:FileCheck",
    ],
)

iree_compiler_cc_test(
    name = "MSLToMetalLibTest",
    testonly = True,
    srcs = ["MSLToMetalLibTest.cpp"],
    deps = [
        "//compiler/plugins/target/MetalSPIRV:MSLToMetalLib",
        "//compiler/src/iree/testing:gtest_main",
        "@com_google_googletest//:gtest",
    ],
)
