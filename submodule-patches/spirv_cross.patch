+               OpCapability BFloat16CooperativeMatrixKHR
+               OpCapability CooperativeMatrixKHR
+               OpCapability Matrix
+               OpCapability VulkanMemoryModel
+               OpExtension "SPV_KHR_bfloat16"
+               OpExtension "SPV_KHR_cooperative_matrix"
+               OpExtension "SPV_KHR_vulkan_memory_model"
+               OpMemoryModel Logical Vulkan
+               OpEntryPoint GLCompute %main "main"
+               OpExecutionMode %main LocalSize 32 1 1
+
+       %void = OpTypeVoid
+         %fn = OpTypeFunction %void
+       %uint = OpTypeInt 32 0
+    %subgroup = OpConstant %uint 3
+       %dim8 = OpConstant %uint 8
+       %useA = OpConstant %uint 0
+       %useB = OpConstant %uint 1
+     %useAcc = OpConstant %uint 2
+   %bfloat16 = OpTypeFloat 16 BFloat16KHR
+      %float = OpTypeFloat 32
+  %bf16_zero = OpConstant %bfloat16 0x0p+0
+ %float_zero = OpConstant %float 0
+       %matA = OpTypeCooperativeMatrixKHR %bfloat16 %subgroup %dim8 %dim8 %useA
+       %matB = OpTypeCooperativeMatrixKHR %bfloat16 %subgroup %dim8 %dim8 %useB
+     %matAcc = OpTypeCooperativeMatrixKHR %float %subgroup %dim8 %dim8 %useAcc
+
+       %main = OpFunction %void None %fn
+      %entry = OpLabel
+          %a = OpCompositeConstruct %matA %bf16_zero
+          %b = OpCompositeConstruct %matB %bf16_zero
+          %c = OpCompositeConstruct %matAcc %float_zero
+          %d = OpCooperativeMatrixMulAddKHR %matAcc %a %b %c
+         %d0 = OpCompositeExtract %float %d 0
+         %d1 = OpCompositeExtract %float %d 1
+               OpReturn
+               OpFunctionEnd
