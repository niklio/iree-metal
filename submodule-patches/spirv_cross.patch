+	uint32_t rows = constant_value(type.ext.cooperative.rows_id, "row count");
+	uint32_t columns = constant_value(type.ext.cooperative.columns_id, "column count");
+	uint32_t use = constant_value(type.ext.cooperative.use_id, "matrix use");
+	if (scope != ScopeSubgroup)
+		SPIRV_CROSS_THROW("Apple cooperative matrices only support Subgroup scope.");
+	if (rows != columns || (rows != 8 && rows != 16))
+		SPIRV_CROSS_THROW("Apple cooperative matrices only support exact 8x8 or 16x16 shapes.");
+	if (use != CooperativeMatrixUseMatrixAKHR && use != CooperativeMatrixUseMatrixBKHR &&
+	    use != CooperativeMatrixUseMatrixAccumulatorKHR)
+		SPIRV_CROSS_THROW("Apple cooperative matrices require MatrixA, MatrixB, or MatrixAccumulator use.");
+
+	auto &element_type = get<SPIRType>(type.parent_type);
+	if (element_type.pointer || !element_type.array.empty() || element_type.vecsize != 1 ||
+	    element_type.columns != 1 ||
+	    (element_type.basetype != SPIRType::Half &&
+	     element_type.basetype != SPIRType::BFloat16 &&
+	     element_type.basetype != SPIRType::Float))
+		SPIRV_CROSS_THROW("Apple cooperative matrices only support scalar f16, bf16, or f32 elements.");
+
+	uint32_t tile_count = (rows / 8) * (columns / 8);
+	uint32_t fragment_count = (rows * columns) / 32;
+	if ((tile_count != 1 && tile_count != 4) ||
+	    (fragment_count != 2 && fragment_count != 8))
+		SPIRV_CROSS_THROW("Unsupported Apple cooperative-matrix tile or per-lane fragment count.");
+
+	return { rows, columns, use, element_type.basetype, tile_count, fragment_count };
+}
+
+const SPIRType &CompilerMSL::apple_cooperative_matrix_physical_type(uint32_t id) const
+{
+	auto conversion = apple_cooperative_matrix_conversion_source_types.find(id);
+	if (conversion != apple_cooperative_matrix_conversion_source_types.end())
+		return get<SPIRType>(conversion->second);
+	return expression_type(id);
+}
+
+void CompilerMSL::validate_apple_cooperative_matrix_role(const AppleCooperativeMatrixInfo &info) const
+{
+	if (info.use == CooperativeMatrixUseMatrixAccumulatorKHR)
+	{
+		if (info.element_type != SPIRType::Float)
+			SPIRV_CROSS_THROW("Apple MatrixAccumulator cooperative matrices must use f32 elements.");
+	}
+	else if (info.element_type != SPIRType::Half && info.element_type != SPIRType::BFloat16)
+	{
+		SPIRV_CROSS_THROW("Apple MatrixA and MatrixB cooperative matrices must use f16 or bf16 elements.");
+	}
+}
+
+uint32_t CompilerMSL::validate_apple_cooperative_matrix_layout(uint32_t id) const
+{
+	auto *layout = maybe_get<SPIRConstant>(id);
+	if (!layout || layout->specialization)
+		SPIRV_CROSS_THROW("Apple cooperative-matrix load/store layout must be a literal constant.");
+	uint32_t value = layout->scalar();
+	if (value != CooperativeMatrixLayoutRowMajorKHR &&
+	    value != CooperativeMatrixLayoutColumnMajorKHR)
+		SPIRV_CROSS_THROW("Apple cooperative matrices only support RowMajorKHR or ColumnMajorKHR layout.");
+	return value;
+}
+
+const char *CompilerMSL::validate_apple_cooperative_matrix_pointer(uint32_t id) const
+{
+	auto &pointer_type = expression_type(id);
+	if (!pointer_type.pointer)
+		SPIRV_CROSS_THROW("Apple cooperative-matrix load/store requires a pointer operand.");
+	if (pointer_type.storage == StorageClassWorkgroup)
+		return "threadgroup";
+	if (pointer_type.storage == StorageClassStorageBuffer)
+		return "device";
+	SPIRV_CROSS_THROW("Apple cooperative-matrix load/store only supports Workgroup or StorageBuffer memory.");
+}
+
+void CompilerMSL::validate_apple_cooperative_matrix_optional_operands(const uint32_t *ops,
+                                                                      uint32_t length,
+                                                                      uint32_t required_length,
+                                                                      const char *operation) const
+{
+	if (length < required_length || length > required_length + 1)
+		SPIRV_CROSS_THROW(join("Invalid ", operation, " operand count."));
+	if (length == required_length + 1 && ops[required_length] != 0)
+		SPIRV_CROSS_THROW(join(operation, " only supports zero optional operands or flags on Metal."));
+}
+
+string CompilerMSL::cooperative_matrix_replicated_constant(const SPIRConstant &c)
+{
+	auto &type = get<SPIRType>(c.constant_type);
+	auto info = validate_apple_cooperative_matrix_type(type);
+	validate_apple_cooperative_matrix_role(info);
+	if (c.subconstants.size() != 1)
+		SPIRV_CROSS_THROW("Apple cooperative-matrix replicated constants require exactly one scalar.");
+	return join(type_to_glsl(type), "(", to_expression(c.subconstants[0]), ")");
+}
+
+string CompilerMSL::constant_expression(const SPIRConstant &c,
+                                        bool inside_block_like_struct_scope,
+                                        bool inside_struct_scope)
+{
+	auto &type = get<SPIRType>(c.constant_type);
+	if (type.op == OpTypeCooperativeMatrixKHR && (!c.replicated || c.subconstants.size() != 1))
+		SPIRV_CROSS_THROW("Apple cooperative-matrix constants require exactly one replicated scalar.");
+	return CompilerGLSL::constant_expression(c, inside_block_like_struct_scope, inside_struct_scope);
+}
+
+// nlearn: SPIR-V coop-matrix Stride is in units of the pointer's pointee type; simdgroup_load/store
+// want elements_per_row in the matrix element (T) units. After we reinterpret the pointer to T*, scale
+// the stride by pointee_bytes / T_bytes (e.g. a vector<4xf32> shared buffer loaded as half -> x8).
+string CompilerMSL::coop_stride_in_elems(uint32_t ptr_op, uint32_t stride_op, const SPIRType &elem)
+{
+	auto &pt = expression_type(ptr_op);
+	auto &ptee = pt.pointer ? get<SPIRType>(pt.parent_type) : pt;
+	uint32_t pbytes = (ptee.width / 8) * (ptee.vecsize ? ptee.vecsize : 1);
+	uint32_t ebytes = elem.width / 8;
+	if (!pbytes || !ebytes || pbytes < ebytes || pbytes % ebytes != 0)
+		SPIRV_CROSS_THROW("Apple cooperative-matrix load/store pointer pointee byte width must be an integer multiple "
+		                  "of the matrix element byte width.");
+	uint32_t factor = pbytes / ebytes;
+	return factor == 1 ? to_expression(stride_op) : join("(", to_expression(stride_op), " * ", factor, ")");
+}
+
+string CompilerMSL::cooperative_matrix_type_name(const SPIRType &type)
+{
+	auto info = validate_apple_cooperative_matrix_type(type);
+	validate_apple_cooperative_matrix_role(info);
+	auto &elem = get<SPIRType>(type.parent_type);
+	if (spv_function_implementations.count(SPVFuncImplCooperativeMatrix) == 0)
+		add_spv_func_and_recompile(SPVFuncImplCooperativeMatrix);
+	return join("spvCoopMat<", type_to_glsl(elem), ", ", info.tile_count, ">");
+}
