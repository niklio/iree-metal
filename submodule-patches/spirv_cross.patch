@@ -0,0 +1,375 @@
+#!/usr/bin/env python3
+
+# Copyright 2026 The IREE Authors
+# SPDX-License-Identifier: Apache-2.0
+
+import argparse
+import pathlib
+import subprocess
+import tempfile
+
+
+def replace_once(source, old, new):
+    if source.count(old) != 1:
+        raise RuntimeError("Expected exactly one occurrence of: " + old)
+    return source.replace(old, new, 1)
+
+
+def assemble(spirv_as, source, directory, name):
+    asm_path = directory / (name + ".spvasm")
+    spv_path = directory / (name + ".spv")
+    asm_path.write_text(source)
+    subprocess.run(
+        [spirv_as, "--target-env", "spv1.6", str(asm_path), "-o", str(spv_path)],
+        check=True,
+        text=True,
+        capture_output=True,
+    )
+    return spv_path
+
+
+def compile_msl(spirv_cross, spv_path, directory, name, version="30100"):
+    output_path = directory / (name + ".metal")
+    return subprocess.run(
+        [
+            spirv_cross,
+            str(spv_path),
+            "--msl",
+            "--msl-version",
+            version,
+            "--entry",
+            "main",
+            "--output",
+            str(output_path),
+        ],
+        text=True,
+        capture_output=True,
+    ), output_path
+
+
+def expect_failure(spirv_as, spirv_cross, source, directory, name, diagnostic, version="30100"):
+    spv_path = assemble(spirv_as, source, directory, name)
+    result, _ = compile_msl(spirv_cross, spv_path, directory, name, version)
+    if result.returncode == 0:
+        raise RuntimeError(name + " unexpectedly compiled successfully")
+    if diagnostic not in result.stderr:
+        raise RuntimeError(
+            name + " produced the wrong diagnostic:\n" + result.stderr
+        )
+
+
+def make_store_case(source, layout):
+    source = replace_once(
+        source,
+        'OpEntryPoint GLCompute %main "main"',
+        'OpEntryPoint GLCompute %main "main" %buffer',
+    )
+    source = replace_once(
+        source,
+        "               OpExecutionMode %main LocalSize 32 1 1\n",
+        """               OpExecutionMode %main LocalSize 32 1 1
+               OpDecorate %runtime_half ArrayStride 2
+               OpMemberDecorate %buffer_block 0 Offset 0
+               OpDecorate %buffer_block Block
+               OpDecorate %buffer Binding 0
+               OpDecorate %buffer DescriptorSet 0
+""",
+    )
+    source = replace_once(
+        source,
+        "     %matAcc = OpTypeCooperativeMatrixKHR %float %subgroup %dim8 %dim8 %useAcc\n",
+        f"""     %matAcc = OpTypeCooperativeMatrixKHR %float %subgroup %dim8 %dim8 %useAcc
+%runtime_half = OpTypeRuntimeArray %half
+%buffer_block = OpTypeStruct %runtime_half
+%ptr_buffer_block = OpTypePointer StorageBuffer %buffer_block
+      %buffer = OpVariable %ptr_buffer_block StorageBuffer
+    %ptr_half = OpTypePointer StorageBuffer %half
+      %index0 = OpConstant %uint 0
+      %layout = OpConstant %uint {layout}
+      %stride = OpConstant %uint 8
+""",
+    )
+    return replace_once(
+        source,
+        "          %a = OpCompositeConstruct %matA %half_zero\n",
+        """          %a = OpCompositeConstruct %matA %half_zero
+        %ptr = OpAccessChain %ptr_half %buffer %index0 %index0
+               OpCooperativeMatrixStoreKHR %ptr %a %layout %stride
+""",
+    )
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--spirv-cross", required=True)
+    parser.add_argument("--spirv-as", required=True)
+    parser.add_argument("--spirv-val", required=True)
+    parser.add_argument("--shader-dir", required=True)
+    args = parser.parse_args()
+
+    shader_dir = pathlib.Path(args.shader_dir)
+    positive_cases = [
+        ("apple-cooperative-matrix-f16-8.msl31.spv16.asm.comp", "half", 1, 1),
+        ("apple-cooperative-matrix-f16-16.msl31.spv16.asm.comp", "half", 4, 8),
+        ("apple-cooperative-matrix-bf16-8.msl31.spv16.asm.comp", "bfloat", 1, 1),
+        ("apple-cooperative-matrix-bf16-16.msl31.spv16.asm.comp", "bfloat", 4, 8),
+    ]
+
+    with tempfile.TemporaryDirectory() as tmp:
+        directory = pathlib.Path(tmp)
+        for filename, element, tiles, mma_count in positive_cases:
+            source = (shader_dir / filename).read_text()
+            name = filename.replace(".", "_")
+            spv_path = assemble(args.spirv_as, source, directory, name)
+            subprocess.run(
+                [args.spirv_val, "--target-env", "spv1.6", str(spv_path)],
+                check=True,
+                text=True,
+                capture_output=True,
+            )
+            result, output_path = compile_msl(
+                args.spirv_cross, spv_path, directory, name
+            )
+            if result.returncode != 0:
+                raise RuntimeError(filename + " failed to compile:\n" + result.stderr)
+            output = output_path.read_text()
+            expected_type = "spvCoopMat<%s, %d>" % (element, tiles)
+            if expected_type not in output:
+                raise RuntimeError(filename + " did not emit " + expected_type)
+            if output.count("simdgroup_multiply_accumulate(") != mma_count:
+                raise RuntimeError(filename + " emitted the wrong MMA tile count")
+
+        base = (
+            shader_dir
+            / "apple-cooperative-matrix-f16-8.msl31.spv16.asm.comp"
+        ).read_text()
+
+        # Both representable memory layouts compile, while extension layouts
+        # must not silently fall back to row-major.
+        for layout in (0, 1):
+            source = make_store_case(base, layout)
+            name = "supported_layout_%d" % layout
+            spv_path = assemble(args.spirv_as, source, directory, name)
+            result, output_path = compile_msl(
+                args.spirv_cross, spv_path, directory, name
+            )
+            if result.returncode != 0:
+                raise RuntimeError(name + " failed to compile:\n" + result.stderr)
+            output = output_path.read_text()
+            if "simdgroup_store(" not in output:
+                raise RuntimeError(name + " did not emit simdgroup_store")
+            if layout == 1 and ", true);" not in output:
+                raise RuntimeError(name + " did not emit a transposed store")
+
+        byte_pointer = make_store_case(base, 0)
+        byte_pointer = replace_once(
+            byte_pointer,
+            "               OpDecorate %runtime_half ArrayStride 2",
+            "               OpDecorate %runtime_half ArrayStride 1",
+        )
+        byte_pointer = replace_once(
+            byte_pointer,
+            "%runtime_half = OpTypeRuntimeArray %half",
+            """      %uchar = OpTypeInt 8 0
+%runtime_half = OpTypeRuntimeArray %uchar""",
+        )
+        byte_pointer = replace_once(
+            byte_pointer,
+            "    %ptr_half = OpTypePointer StorageBuffer %half",
+            "    %ptr_half = OpTypePointer StorageBuffer %uchar",
+        )
+        expect_failure(
+            args.spirv_as,
+            args.spirv_cross,
+            byte_pointer,
+            directory,
+            "unsupported_pointer_element_width",
+            "pointer pointee byte width must be an integer multiple",
+        )
+
+        nondivisible_pointer = make_store_case(base, 0)
+        nondivisible_pointer = replace_once(
+            nondivisible_pointer,
+            "               OpDecorate %runtime_half ArrayStride 2",
+            "               OpDecorate %runtime_half ArrayStride 3",
+        )
+        nondivisible_pointer = replace_once(
+            nondivisible_pointer,
+            "%runtime_half = OpTypeRuntimeArray %half",
+            """      %uchar = OpTypeInt 8 0
+     %uchar3 = OpTypeVector %uchar 3
+%runtime_half = OpTypeRuntimeArray %uchar3""",
+        )
+        nondivisible_pointer = replace_once(
+            nondivisible_pointer,
+            "    %ptr_half = OpTypePointer StorageBuffer %half",
+            "    %ptr_half = OpTypePointer StorageBuffer %uchar3",
+        )
+        expect_failure(
+            args.spirv_as,
+            args.spirv_cross,
+            nondivisible_pointer,
+            directory,
+            "unsupported_nondivisible_pointer_element_width",
+            "pointer pointee byte width must be an integer multiple",
+        )
+
+        # The only legal cooperative FConvert alias is a widening A/B view
+        # consumed by mixed-precision MMA.
+        widening = replace_once(
+            base,
+            "     %matAcc = OpTypeCooperativeMatrixKHR %float %subgroup %dim8 %dim8 %useAcc\n",
+            """     %matAcc = OpTypeCooperativeMatrixKHR %float %subgroup %dim8 %dim8 %useAcc
+  %matAFloat = OpTypeCooperativeMatrixKHR %float %subgroup %dim8 %dim8 %useA
+""",
+        )
+        widening = replace_once(
+            widening,
+            "          %a = OpCompositeConstruct %matA %half_zero\n",
+            """          %a = OpCompositeConstruct %matA %half_zero
+     %a_wide = OpFConvert %matAFloat %a
+""",
+        )
+        widening = replace_once(
+            widening,
+            "          %d = OpCooperativeMatrixMulAddKHR %matAcc %a %b %c\n",
+            "          %d = OpCooperativeMatrixMulAddKHR %matAcc %a_wide %b %c\n",
+        )
+        spv_path = assemble(args.spirv_as, widening, directory, "supported_widening")
+        result, output_path = compile_msl(
+            args.spirv_cross, spv_path, directory, "supported_widening"
+        )
+        if result.returncode != 0:
+            raise RuntimeError("supported widening failed:\n" + result.stderr)
+        output = output_path.read_text()
+        if "spvCoopMat<half, 1>" not in output or "simdgroup_multiply_accumulate(" not in output:
+            raise RuntimeError("supported widening lost its physical f16 MMA operand")
+
+        expect_failure(
+            args.spirv_as,
+            args.spirv_cross,
+            base,
+            directory,
+            "unsupported_version",
+            "require MSL 3.1 or later",
+            "30000",
+        )
+        expect_failure(
+            args.spirv_as,
+            args.spirv_cross,
+            replace_once(
+                base,
+                "    %subgroup = OpConstant %uint 3",
+                "    %subgroup = OpConstant %uint 2",
+            ),
+            directory,
+            "unsupported_scope",
+            "only support Subgroup scope",
+        )
+        expect_failure(
+            args.spirv_as,
+            args.spirv_cross,
+            replace_once(
+                base,
+                "       %half = OpTypeFloat 16",
+                "       %half = OpTypeFloat 32",
+            ),
+            directory,
+            "unsupported_type",
+            "MatrixA and MatrixB cooperative matrices must use f16 or bf16",
+        )
+        expect_failure(
+            args.spirv_as,
+            args.spirv_cross,
+            replace_once(
+                base,
+                "       %dim8 = OpConstant %uint 8",
+                "       %dim8 = OpConstant %uint 12",
+            ),
+            directory,
+            "unsupported_dimension",
+            "only support exact 8x8 or 16x16 shapes",
+        )
+        expect_failure(
+            args.spirv_as,
+            args.spirv_cross,
+            make_store_case(base, 4202),
+            directory,
+            "unsupported_layout",
+            "only support RowMajorKHR or ColumnMajorKHR layout",
+        )
+        expect_failure(
+            args.spirv_as,
+            args.spirv_cross,
+            replace_once(
+                base,
+                "          %d = OpCooperativeMatrixMulAddKHR %matAcc %a %b %c",
+                "          %d = OpCooperativeMatrixMulAddKHR %matAcc %a %b %c SaturatingAccumulationKHR",
+            ),
+            directory,
+            "unsupported_flags",
+            "only supports zero optional operands or flags",
+        )
+        expect_failure(
+            args.spirv_as,
+            args.spirv_cross,
+            replace_once(
+                base,
+                "         %d1 = OpCompositeExtract %float %d 1",
+                "         %d1 = OpCompositeExtract %float %d 2",
+            ),
+            directory,
+            "unsupported_fragment_index",
+            "index exceeds the per-lane fragment count",
+        )
+        expect_failure(
+            args.spirv_as,
+            args.spirv_cross,
+            replace_once(
+                base,
+                "         %d1 = OpCompositeExtract %float %d 1",
+                "         %d1 = OpVectorExtractDynamic %float %d %useAcc",
+            ),
+            directory,
+            "unsupported_dynamic_fragment_index",
+            "Dynamic indexing of Apple cooperative-matrix fragments is not supported",
+        )
+        expect_failure(
+            args.spirv_as,
+            args.spirv_cross,
+            replace_once(
+                base,
+                "          %a = OpCompositeConstruct %matA %half_zero",
+                "          %a = OpCompositeConstruct %matA %half_zero %half_zero",
+            ),
+            directory,
+            "unsupported_fragment_count",
+            "only support a one-scalar replicated OpCompositeConstruct",
+        )
+
+        narrowing = replace_once(
+            base,
+            "     %matAcc = OpTypeCooperativeMatrixKHR %float %subgroup %dim8 %dim8 %useAcc\n",
+            """     %matAcc = OpTypeCooperativeMatrixKHR %float %subgroup %dim8 %dim8 %useAcc
+ %matAccHalf = OpTypeCooperativeMatrixKHR %half %subgroup %dim8 %dim8 %useAcc
+""",
+        )
+        narrowing = replace_once(
+            narrowing,
+            "          %c = OpCompositeConstruct %matAcc %float_zero\n",
+            """          %c = OpCompositeConstruct %matAcc %float_zero
+   %c_narrow = OpFConvert %matAccHalf %c
+""",
+        )
+        expect_failure(
+            args.spirv_as,
+            args.spirv_cross,
+            narrowing,
+            directory,
+            "unsupported_fconvert",
+            "OpFConvert only supports an exact f16/bf16 to f32 widening view",
+        )
+
+
+if __name__ == "__main__":
+    main()
