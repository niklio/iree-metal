+      %B = gpu.subgroup_mma_elementwise extf %A :
+        (!gpu.mma_matrix<16x16xbf16, "COp">) ->
+        !gpu.mma_matrix<16x16xf32, "COp">
+      %c0 = arith.constant 0 : index
+      gpu.subgroup_mma_store_matrix %B, %out[%c0, %c0]
+        {leadDimension = 16 : index} :
