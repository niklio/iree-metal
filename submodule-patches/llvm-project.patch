+         !gpu.mma_matrix<16x16xbf16, "COp">) ->
+        !gpu.mma_matrix<16x16xbf16, "COp">
+      %D = gpu.subgroup_mma_elementwise extf %C :
+        (!gpu.mma_matrix<16x16xbf16, "COp">) ->
+        !gpu.mma_matrix<16x16xf32, "COp">
+      %c0 = arith.constant 0 : index
+      gpu.subgroup_mma_store_matrix %D, %out[%c0, %c0]
+        {leadDimension = 16 : index} :
+        !gpu.mma_matrix<16x16xf32, "COp">,
+        memref<16x16xf32, #spirv.storage_class<StorageBuffer>>
+      gpu.return
+    }
+  }
+}
