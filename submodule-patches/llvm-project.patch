-static bool fpTruncSupportsMMAMatrixType(arith::TruncFOp extOp) { return true; }
+static bool fpTruncSupportsMMAMatrixType(arith::TruncFOp extOp) {
+  // nlearn: Apple simdgroup_matrix has NO elementwise ops (matmul-only). Opt out of
+  // fusing the truncf store-downcast into coop so it stays a regular op (the coop f32
+  // C is staged to smem by C-promotion, then a regular truncf converts f32->f16).
+  return !getenv("NLEARN_NO_COOP_ELEMENTWISE");
+}
 
 /// Return the MMA elementwise enum associated with `op` if it is supported.
 /// Return `std::nullopt` otherwise.
@@ -266,6 +271,30 @@ convertElementwiseOpToMMA(Operation *op) {
 
 /// Return true if the op is supported as elementwise op on MMAMatrix type.
 static bool elementwiseSupportsMMAMatrixType(Operation *op) {
+  // nlearn: Apple simdgroup_matrix is matmul-only (no elementwise), so a softmax
+  // epilogue fused onto coop types can't compile. Opt out so these stay regular
+  // vector ops off the matrix units (only the matmul contract converts to coop).
+  if (getenv("NLEARN_NO_COOP_ELEMENTWISE"))
+    return false;
+  // nlearn: SPIR-V cooperative-matrix component-wise arithmetic (spirv.FMul etc.)
+  // is only defined for f16/f32/f64 fragments; a bf16 coop matrix supports ONLY
+  // MulAdd (matmul), not elementwise. A bf16 PROLOGUE elementwise (e.g. the SwiGLU
+  // gate feeding w2, or a fused A*A on a matmul input) writes the promoted A/B tile
+  // and, having a transfer_write user (not the contract directly), infers COp and
+  // gets absorbed into an illegal `spirv.FMul` on coopmatrix<...xbf16, MatrixAcc>
+  // (fails metal-spirv legalization). Keep bf16 elementwise as a REGULAR vector op
+  // so it applies to the promoted tile in-kernel (fused, off the matrix units) and
+  // the matmul still coop-loads the modified tile. Epilogues on the f32 accumulator
+  // are unaffected (f32 element type). Opt out: NLEARN_COOP_ALLOW_BF16_ELEMENTWISE.
+  if (!getenv("NLEARN_COOP_ALLOW_BF16_ELEMENTWISE")) {
+    auto isBF16Vec = [](Type t) {
+      auto vt = dyn_cast<VectorType>(t);
+      return vt && vt.getElementType().isBF16();
+    };
+    if (llvm::any_of(op->getResultTypes(), isBF16Vec) ||
+        llvm::any_of(op->getOperandTypes(), isBF16Vec))
+      return false;
+  }
   return convertElementwiseOpToMMA(op).has_value();
 }
 
