+
+// A BF16 cooperative matrix requires the dedicated capability, not merely the
+// base BF16 and cooperative-matrix capabilities.
+// CHECK: requires #spirv.vce<v1.6, [BFloat16TypeKHR, BFloat16CooperativeMatrixKHR, CooperativeMatrixKHR, Shader, Matrix], [SPV_KHR_bfloat16, SPV_KHR_cooperative_matrix]>
+spirv.module Logical GLSL450 attributes {
+  spirv.target_env = #spirv.target_env<
+    #spirv.vce<v1.6, [Shader, BFloat16CooperativeMatrixKHR],
+      [SPV_KHR_bfloat16, SPV_KHR_cooperative_matrix]>,
+    #spirv.resource_limits<>>
+} {
+  spirv.func @bf16_cooperative_matrix(
+      %arg : !spirv.coopmatrix<16x16xbf16, Subgroup, MatrixA>)
+      -> !spirv.coopmatrix<16x16xbf16, Subgroup, MatrixA> "None" {
+    spirv.ReturnValue %arg :
+      !spirv.coopmatrix<16x16xbf16, Subgroup, MatrixA>
+  }
+}
diff --git a/mlir/test/Dialect/SPIRV/Transforms/vce-deduction-invalid.mlir b/mlir/test/Dialect/SPIRV/Transforms/vce-deduction-invalid.mlir
new file mode 100644
index 000000000..b6ecf00d8
--- /dev/null
+++ b/mlir/test/Dialect/SPIRV/Transforms/vce-deduction-invalid.mlir
@@ -0,0 +1,19 @@
+// RUN: mlir-opt -spirv-update-vce -verify-diagnostics %s
+
+// BFloat16TypeKHR plus CooperativeMatrixKHR is insufficient for a BF16
+// cooperative matrix. SPV_KHR_bfloat16 requires the dedicated combined
+// capability.
+spirv.module Logical GLSL450 attributes {
+  spirv.target_env = #spirv.target_env<
+    #spirv.vce<v1.6, [Shader, BFloat16TypeKHR, CooperativeMatrixKHR],
+      [SPV_KHR_bfloat16, SPV_KHR_cooperative_matrix]>,
+    #spirv.resource_limits<>>
+} {
+  spirv.func @bf16_cooperative_matrix_missing_capability(
+      %arg : !spirv.coopmatrix<16x16xbf16, Subgroup, MatrixA>)
+      -> !spirv.coopmatrix<16x16xbf16, Subgroup, MatrixA> "None" {
+    // expected-error @+1 {{'spirv.ReturnValue' requires at least one capability in [BFloat16CooperativeMatrixKHR] but none allowed in target environment}}
+    spirv.ReturnValue %arg :
+      !spirv.coopmatrix<16x16xbf16, Subgroup, MatrixA>
+  }
+}
