+        %B: !gpu.mma_matrix<16x16xbf16, "COp">,
+        %out: memref<16x16xf32, #spirv.storage_class<StorageBuffer>>) kernel
+      attributes {
+        spirv.entry_point_abi =
+          #spirv.entry_point_abi<workgroup_size = [32, 4, 1]>
+      } {
