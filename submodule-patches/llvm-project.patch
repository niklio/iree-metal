diff --git a/mlir/lib/Conversion/VectorToGPU/VectorToGPU.cpp b/mlir/lib/Conversion/VectorToGPU/VectorToGPU.cpp
index 975fe2839..d4e367474 100644
--- a/mlir/lib/Conversion/VectorToGPU/VectorToGPU.cpp
