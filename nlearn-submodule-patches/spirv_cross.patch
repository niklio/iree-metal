+// nlearn: name for a SPIR-V cooperative matrix rendered as MSL simdgroup_matrix tiles. Metal's
+// simdgroup_matrix is 8x8, so an RxC coop matrix becomes array<simdgroup_matrix<T,8,8>, (R/8)*(C/8)>
+// (a self-contained MSL value type; no custom struct needed). Tile (r,c) is at index r*(C/8)+c.
+// nlearn: a replicated (splat) coop-matrix constant (e.g. the zero-initialized accumulator) -> an
+// array of tiles each built with make_filled_simdgroup_matrix (base GLSL emits an invalid scalar ctor).
+string CompilerMSL::cooperative_matrix_replicated_constant(const SPIRConstant &c)
+{
+	auto &type = get<SPIRType>(c.constant_type);
+	auto &elem = get<SPIRType>(type.parent_type);
+	uint32_t rows = get<SPIRConstant>(type.ext.cooperative.rows_id).scalar();
+	uint32_t cols = get<SPIRConstant>(type.ext.cooperative.columns_id).scalar();
+	uint32_t tiles = (rows / 8) * (cols / 8);
+	if (tiles == 0)
+		tiles = 1;
+	string val = to_expression(c.subconstants[0]);
+	string tile = join("make_filled_simdgroup_matrix<", type_to_glsl(elem), ", 8, 8>(", val, ")");
+	string res = type_to_glsl(type) + "({ ";
+	for (uint32_t i = 0; i < tiles; i++)
+		res += (i ? ", " : "") + tile;
+	res += " })";
+	return res;
+}
+
+// nlearn: SPIR-V coop-matrix Stride is in units of the pointer's pointee type; simdgroup_load/store
+// want elements_per_row in the matrix element (T) units. After we reinterpret the pointer to T*, scale
+// the stride by pointee_bytes / T_bytes (e.g. a vector<4xf32> shared buffer loaded as half -> x8).
+string CompilerMSL::coop_stride_in_elems(uint32_t ptr_op, uint32_t stride_op, const SPIRType &elem)
+{
+	auto &pt = expression_type(ptr_op);
+	auto &ptee = pt.pointer ? get<SPIRType>(pt.parent_type) : pt;
+	uint32_t pbytes = (ptee.width / 8) * (ptee.vecsize ? ptee.vecsize : 1);
+	uint32_t ebytes = elem.width / 8;
+	uint32_t factor = (ebytes && pbytes >= ebytes) ? pbytes / ebytes : 1;
+	if (factor == 0)
+		factor = 1;
+	return factor == 1 ? to_expression(stride_op) : join("(", to_expression(stride_op), " * ", factor, ")");
+}
+
+string CompilerMSL::cooperative_matrix_type_name(const SPIRType &type)
+{
+	auto &elem = get<SPIRType>(type.parent_type);
+	uint32_t rows = get<SPIRConstant>(type.ext.cooperative.rows_id).scalar();
+	uint32_t cols = get<SPIRConstant>(type.ext.cooperative.columns_id).scalar();
+	uint32_t tiles = (rows / 8) * (cols / 8);
+	if (tiles == 0)
+		tiles = 1;
+	// spvCoopMat<T,N> (emitted helper) gives operator[] (so mat[i] tile access works) + a scalar
+	// constructor (so a splat constant like spvCoopMat<float,4>(0.0) is valid MSL).
+	if (spv_function_implementations.count(SPVFuncImplCooperativeMatrix) == 0)
+		add_spv_func_and_recompile(SPVFuncImplCooperativeMatrix);
+	return join("spvCoopMat<", type_to_glsl(elem), ", ", tiles, ">");
+}
